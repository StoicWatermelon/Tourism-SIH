# Bharat Explore - Environment Variables Template
# Provide your Google Gemini API Key below
GEMINI_API_KEY=your_gemini_api_key_here
CARTO_API_KEY=your_carto_api_key_here

# JWT Authentication Configuration
JWT_SECRET_KEY=bharat_explore_jwt_secret_sih_2026_super_secure_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==============================================================================
# Supabase Cloud Database & Authentication (https://supabase.com)
# Modern Supabase API Key Schema:
# - SUPABASE_ANON_KEY starts with 'sb_publishable_'
# - SUPABASE_SERVICE_ROLE_KEY starts with 'sb_secret_'
# ==============================================================================
# 1. Project URL (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Modern Publishable Anon Key (starts with 'sb_publishable_')
SUPABASE_ANON_KEY=sb_publishable_your_supabase_anon_key_here

# 3. Modern Service Role Secret Key (starts with 'sb_secret_')
# CAUTION: Kept only in backend server environment, never exposed to client
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_supabase_service_role_key_here

