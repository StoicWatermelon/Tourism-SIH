{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/html/(.*)",
      "dest": "/html/$1"
    },
    {
      "src": "/(manifest\\.json|robots\\.txt|sitemap\\.xml)",
      "dest": "/$1"
    },
    {
      "src": "/favicon\\.(ico|png)",
      "dest": "/assets/images/favicon.png"
    },
    {
      "src": "/(explore|circuits|map|planner|ai|responsible|culture|food|home|login|register|profile|CodeBreakerz)(\\.html)?",
      "dest": "/html/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
